FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
USER $APP_UID
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["ContainRs.WebApp/ContainRs.WebApp.csproj", "ContainRs.WebApp/"]
COPY ["ContainRs.Domain/ContainRs.Domain.csproj", "ContainRs.Domain/"]
COPY ["ContainRs.Application/ContainRs.Application.csproj", "ContainRs.Application/"]
RUN dotnet restore "ContainRs.WebApp/ContainRs.WebApp.csproj"
COPY . .
WORKDIR "/src/ContainRs.WebApp"
RUN dotnet build "./ContainRs.WebApp.csproj" -c $BUILD_CONFIGURATION -o /app/build

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./ContainRs.WebApp.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "ContainRs.WebApp.dll"]
